# Makevars.win for Windows
# scPAS package compilation configuration for Windows

# Compiler flags for Windows
# Note: OpenMP support on Windows may require special handling
PKG_CXXFLAGS = $(SHLIB_OPENMP_CXXFLAGS) -DNDEBUG

# Libraries to link on Windows
PKG_LIBS = $(SHLIB_OPENMP_CXXFLAGS) $(LAPACK_LIBS) $(BLAS_LIBS) $(FLIBS)

# Include paths - critical for Windows to find headers
PKG_CPPFLAGS = -I../inst/include -I$(R_INCLUDE_DIR)
