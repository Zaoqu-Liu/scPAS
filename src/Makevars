# Makevars for Unix/Linux/macOS
# scPAS package compilation configuration

# Compiler flags for all platforms
PKG_CXXFLAGS = $(SHLIB_OPENMP_CXXFLAGS) -DNDEBUG

# Libraries to link
PKG_LIBS = $(SHLIB_OPENMP_CXXFLAGS) $(LAPACK_LIBS) $(BLAS_LIBS) $(FLIBS)

# Include paths
PKG_CPPFLAGS = -I../inst/include
